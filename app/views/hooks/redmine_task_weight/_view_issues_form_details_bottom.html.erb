<% 
  project = @project || (@issue ? @issue.project : nil)
  if project && project.module_enabled?(:task_weight)
    all_settings = (Setting.plugin_redmine_task_weight || {}).with_indifferent_access
    target_id = all_settings[:weight_custom_field_id]

    weight_field = (target_id.present? ? IssueCustomField.find_by(id: target_id.to_i) : nil) || 
                   IssueCustomField.find_by(name: 'Peso de la Tarea') || 
                   IssueCustomField.find_by(name: 'Task Weight') || 
                   IssueCustomField.find_by(name: 'Peso') || 
                   IssueCustomField.find_by(name: 'Weight')
    if weight_field
      project_rules_all = all_settings[:project_rules] || {}
      p_rules = (project_rules_all[project.id] || project_rules_all[project.id.to_s] || {}).with_indifferent_access
%>
  <script type="text/javascript">
    (function() {
      var projectRules = <%= p_rules.to_json.html_safe %>;
      var weightFieldId = <%= weight_field.id.to_json.html_safe %>;

      function formatWeightVal(val) {
        var rounded = Math.round(val * 100) / 100;
        return (rounded % 1 === 0) ? rounded.toString() : rounded.toString();
      }

      function updateLiveWeight() {
        var mode = projectRules.mode || 'factorial';
        if (mode === 'manual') return; // En Modo Manual no se autocalcula en JS

        var weightInput = document.querySelector('input[name="issue[custom_field_values][' + weightFieldId + ']"]');
        if (!weightInput) return;

        if (weightInput.dataset.manualEdited === "true") return;

        var trackerSelect = document.getElementById('issue_tracker_id');
        var catSelect = document.getElementById('issue_category_id');
        var prioSelect = document.getElementById('issue_priority_id');

        var trackerId = trackerSelect ? trackerSelect.value : '';
        var catId = (catSelect && catSelect.value) ? catSelect.value : '0';
        var prioId = prioSelect ? prioSelect.value : '';

        var calculated = 1.0;

        if (mode === 'priority') {
          var prioFactors = projectRules.priority_factors || {};
          if (prioId && prioFactors[prioId] !== undefined) {
            calculated = parseFloat(prioFactors[prioId]) || 1.0;
          } else {
            calculated = parseFloat(prioId) || 1.0;
          }
        } else if (mode === 'factorial') {
          var trackerFactors = projectRules.tracker_factors || {};
          var trackerF = (trackerId && trackerFactors[trackerId] !== undefined) ? parseFloat(trackerFactors[trackerId]) : 1.0;

          var catFactors = projectRules.category_factors || {};
          var catF = (catFactors[catId] !== undefined) ? parseFloat(catFactors[catId]) : 1.0;

          var prioFactors = projectRules.priority_factors || {};
          var prioF = (prioId && prioFactors[prioId] !== undefined) ? parseFloat(prioFactors[prioId]) : 1.0;

          var customCfF = 1.0;
          var extraCfId = projectRules.custom_field_id;
          if (extraCfId) {
            var extraInput = document.querySelector('[name="issue[custom_field_values][' + extraCfId + ']"]');
            if (extraInput && extraInput.value) {
              var val = extraInput.value.trim();
              var cfFactors = (projectRules.custom_field_factors || {})[extraCfId] || {};
              if (cfFactors[val] !== undefined) {
                customCfF = parseFloat(cfFactors[val]) || 1.0;
              } else if (!isNaN(parseFloat(val)) && parseFloat(val) > 0) {
                customCfF = parseFloat(val);
              }
            }
          }

          calculated = trackerF * catF * prioF * customCfF;
        }

        weightInput.value = formatWeightVal(calculated);
      }

      function initWeightScript() {
        if (projectRules.mode === 'manual') return;

        var weightInput = document.querySelector('input[name="issue[custom_field_values][' + weightFieldId + ']"]');
        if (weightInput) {
          weightInput.addEventListener('input', function() {
            weightInput.dataset.manualEdited = "true";
          });
        }

        ['issue_tracker_id', 'issue_category_id', 'issue_priority_id'].forEach(function(id) {
          var el = document.getElementById(id);
          if (el) {
            el.addEventListener('change', updateLiveWeight);
          }
        });

        var extraCfId = projectRules.custom_field_id;
        if (extraCfId) {
          var extraInput = document.querySelector('[name="issue[custom_field_values][' + extraCfId + ']"]');
          if (extraInput) {
            extraInput.addEventListener('change', updateLiveWeight);
            extraInput.addEventListener('input', updateLiveWeight);
          }
        }

        updateLiveWeight();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initWeightScript);
      } else {
        initWeightScript();
      }
    })();
  </script>
<% 
    end
  end 
%>

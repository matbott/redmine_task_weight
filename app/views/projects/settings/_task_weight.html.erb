<% 
  all_settings = Setting.plugin_redmine_task_weight || {}
  p_settings = (all_settings['project_rules'] || {})[@project.id.to_s] || {}
  current_mode = p_settings['mode'] || 'priority'
  project_rules = p_settings['rules'] || {}
%>

<%= form_tag(project_task_weight_settings_path(@project), method: :post, class: "tabular") do %>
  <div class="box">
    <h3>Calculation Mode for <%= @project.name %></h3>
    <p>
      <label>
        <%= radio_button_tag 'mode', 'priority', current_mode == 'priority' %>
        <strong>By General Priority</strong>
      </label>
      <br>
      <label>
        <%= radio_button_tag 'mode', 'rules', current_mode == 'rules' %>
        <strong>Advanced Matrix (Tracker + Category + Priority)</strong>
      </label>
    </p>
  </div>

  <div class="box">
    <h3>Weight Rule Matrix (Score)</h3>
    <p class="description">Set the automatic weight for issues in this project:</p>

    <table class="list">
      <thead>
        <tr>
          <th>Type (Tracker)</th>
          <th>Category</th>
          <th>Priority</th>
          <th>Weight (Score)</th>
        </tr>
      </thead>
      <tbody>
        <% @project.trackers.each do |tracker| %>
          <% categories = @project.issue_categories.any? ? @project.issue_categories : [nil] %>
          <% categories.each do |cat| %>
            <% IssuePriority.active.each do |prio| %>
              <% cat_id = cat ? cat.id : '0' %>
              <% rule_key = "trk_#{tracker.id}_cat_#{cat_id}_prio_#{prio.id}" %>
              <tr>
                <td><strong><%= tracker.name %></strong></td>
                <td><%= cat ? cat.name : '<i>(No category)</i>'.html_safe %></td>
                <td><%= prio.name %></td>
                <td>
                  <%= text_field_tag "rules[#{rule_key}]", 
                        project_rules[rule_key] || '1.0', 
                        size: 5, style: "text-align: center;" %>
                </td>
              </tr>
            <% end %>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= submit_tag l(:button_save), class: 'button-positive' %>
<% end %>
